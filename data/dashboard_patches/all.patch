+def test_container_samples_gpu_only_with_the_flag(monkeypatch: pytest.MonkeyPatch) -> None:
+    q = _container(monkeypatch, run_s=0.35)
+    reads = {"n": 0}
+
+    def reader() -> list[ms.GpuReading]:
+        reads["n"] += 1
+        return [ms.GpuReading(0, 0.0 if reads["n"] == 1 else 93.0, 7000.0, 23034.0)]
+
+    monkeypatch.setattr(ms, "default_gpu_reader", lambda: reader)
+    job = {"run_id": "run-a", "target": "cifar", "config": {}, "seed": 0, "budget_s": 45,
+           "started_at": time.time(), "gpu_telemetry": {"interval_s": 0.05}}
+    payload = modal_runner._remote_execute(job)
+    metrics = [it for part, it in q.items if part == "run-a" and it.get("type") == "metric"]
+    names = [m["name"] for m in metrics]
+    assert "train_loss" in names
+    util = [m for m in metrics if m["name"] == "gpu_util_pct"]
+    assert len(util) >= 3 and util[0]["value"] == 0.0 and util[-1]["value"] == 93.0   # 0 % windows kept
+    assert [m["step"] for m in util] == list(range(len(util)))
+    assert names.count("gpu_mem_total_mb") == 1 and "gpu_mem_mb" in names
+    # telemetry never reaches the run's result (whose metrics go to the judge prompt)
+    assert payload["result"]["metrics"] == {"epochs": 1.0}
+

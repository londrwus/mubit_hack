+def test_live_demo_race_streams_modal_stats(client: TestClient, stats: FakeStats, tmp_path: Path) -> None:
+    race_id = client.post("/api/races", json=DEMO_RACE).json()["id"]
+    assert client.post(f"/api/races/{race_id}/start").status_code == 200
+    events: list[Any] = []

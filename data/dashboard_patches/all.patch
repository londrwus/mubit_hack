+def _container(monkeypatch: pytest.MonkeyPatch, *, run_s: float) -> _ListQueue:
+    q = _ListQueue()
+    monkeypatch.setattr(modal_runner, "_container_queue", lambda name: q)
+    monkeypatch.setattr(modal_runner, "_needs_volume", lambda *a, **k: False)   # never touch the Volume
+
+    def fake_execute(job: dict[str, Any], emit: Any) -> dict[str, Any]:
+        emit(0, 0.01, "train_loss", 2.0)
+        time.sleep(run_s)
+        return {"ok": True, "result": {"score": 0.9, "metrics": {"epochs": 1.0}}, "logs_tail": []}
+
+    monkeypatch.setattr(modal_runner, "execute_job", fake_execute)
+    return q
+

+def test_live_demo_race_streams_modal_stats(client: TestClient, stats: FakeStats, tmp_path: Path) -> None:
+    race_id = client.post("/api/races", json=DEMO_RACE).json()["id"]
+    assert client.post(f"/api/races/{race_id}/start").status_code == 200
+    events: list[Any] = []
+    with client.websocket_connect(f"/ws/races/{race_id}") as ws:
+        while True:
+            ev = parse_event(ws.receive_text())
+            events.append(ev)
+            if ev.type == "race_finished":
+                break
+    ms_events = [e for e in events if isinstance(e, ModalStatsEvent)]
+    assert ms_events, [e.type for e in events]
+    by_arm = {e.arm: e for e in ms_events}
+    assert set(by_arm) == {ArmKind.opus, ArmKind.opus_bm}
+    o, b = by_arm[ArmKind.opus], by_arm[ArmKind.opus_bm]
+    assert (o.app, o.function, o.containers, o.calls_in_flight, o.idle_containers) == \
+        ("busy-machines-opus", "run_l4", 2, 1, 1)
+    assert (b.app, b.containers, b.idle_containers) == ("busy-machines-bm", 2, 0)
+    assert {a for a, _ in stats.calls} == {"busy-machines-opus", "busy-machines-bm"}
+    assert {f for _, f in stats.calls} == {"run_l4"}
+    sampled = [e for e in ms_events if e.runs_sampled > 0]
+    assert sampled, "no GPU sample joined"
+    for e in sampled:
+        assert e.gpu_util_active_pct == 80.0 and e.gpu_util_pct is not None and e.gpu_util_pct <= 80.0
+    assert any(e.call_ids for e in ms_events) and all(c.startswith("fake-") for e in ms_events for c in e.call_ids)
+    assert any(e.latest_call_id for e in ms_events)
+    # the GPU samples are ordinary metric events too (stored like any metric)
+    assert any(isinstance(e, MetricEvent) and e.name == "gpu_util_pct" for e in events)
+    # the poller stops once the race ended; every tick was logged as evidence
+    deadline = time.time() + 3
+    view = client.get(f"/api/races/{race_id}/modal").json()
+    while view["polling"] and time.time() < deadline:
+        time.sleep(0.05)
+        view = client.get(f"/api/races/{race_id}/modal").json()
+    assert view["enabled"] and not view["polling"] and view["race_status"] == "finished"
+    assert view["arms"]["opus"]["stats"]["containers"] == 2
+    assert all(c["modal_call_id"].startswith("fake-") for c in view["arms"]["opus"]["calls"])
+    log = tmp_path / "modal_stats" / f"race-{race_id}.jsonl"
+    lines = [json.loads(x) for x in log.read_text(encoding="utf-8").splitlines()]
+    assert lines and {s["arm"] for s in lines[0]["snapshots"]} == {"opus", "opus_bm"}

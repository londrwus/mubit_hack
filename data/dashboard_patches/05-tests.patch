+def test_external_race_polled_on_request_with_gpu_join(client: TestClient, stats: FakeStats) -> None:
+    """A demo race run by another process (scripts/bench.py on the same DB): asking for it starts
+    the poller; GPU samples seen on the bus join Modal's container count; it stops at the end."""
+    state = client.app.state.bm   # type: ignore[attr-defined]
+    cfg = RaceConfig.model_validate(DEMO_RACE)
+    db = state.db
+    db.insert_race(race_id="ext1", target=cfg.target, budget_s=cfg.budget_s, gpus_per_arm=2, seed=0,
+                   config=cfg.model_dump(mode="json"), name=cfg.name, mode="dev", llm_mode="mock", runner="modal")
+    db.update_race("ext1", status="running")
+    for kind in ("opus", "opus_bm"):
+        db.insert_arm(arm_id=f"arm-{kind}", race_id="ext1", kind=kind, model="m", llm_mode="mock", n_slots=2,
+                      hardware="L4", price_per_s=0.0)
+    db.upsert_experiment({"id": "e1", "arm_id": "arm-opus", "race_id": "ext1", "status": "running",
+                          "run_ref": "fc-01ABC", "config": {}, "started_at": time.time(), "hardware": "L4"})
+    db.upsert_experiment({"id": "e0", "arm_id": "arm-opus", "race_id": "ext1", "status": "succeeded",
+                          "run_ref": "fc-00OLD", "config": {}, "started_at": 1.0, "ended_at": 2.0})
+    first = client.get("/api/races/ext1/modal").json()
+    assert first["enabled"] and first["polling"] and first["function"] == "run_l4"
+    client.portal.call(state.bus.publish, MetricEvent(race_id="ext1", arm=ArmKind.opus, experiment_id="e1",  # type: ignore[union-attr]
+                                                      step=0, t=1.0, name="gpu_util_pct", value=90.0))
+    client.portal.call(state.bus.publish, MetricEvent(race_id="ext1", arm=ArmKind.opus, experiment_id="e1",  # type: ignore[union-attr]
+                                                      step=0, t=1.0, name="gpu_mem_mb", value=6000.0))
+    deadline = time.time() + 3
+    view = client.get("/api/races/ext1/modal?history=5").json()
+    while view["arms"]["opus"]["stats"] is None and time.time() < deadline:
+        time.sleep(0.05)
+        view = client.get("/api/races/ext1/modal?history=5").json()
+    opus = view["arms"]["opus"]
+    assert opus["stats"]["containers"] == 2 and opus["stats"]["idle_containers"] == 1
+    assert opus["gpu"] == {"gpu_util_pct": 45.0, "gpu_util_active_pct": 90.0, "gpu_mem_mb": 6000.0,
+                           "runs_sampled": 1, "runs_unsampled": 0}
+    assert opus["calls_in_flight"] == ["fc-01ABC"] and opus["latest_call_id"] == "fc-01ABC"
+    assert {c["modal_call_id"] for c in opus["calls"]} == {"fc-01ABC", "fc-00OLD"}
+    # 2 calls in flight, no sample reached this process: unknown, never shown as 0 %
+    assert view["arms"]["opus_bm"]["gpu"]["gpu_util_pct"] is None
+    assert view["arms"]["opus_bm"]["gpu"]["runs_unsampled"] == 2
+    assert 1 <= len(view["history"]) <= 5
+    db.update_race("ext1", status="finished")
+    deadline = time.time() + 3
+    while client.get("/api/races/ext1/modal").json()["polling"] and time.time() < deadline:
+        time.sleep(0.05)
+    n = len(stats.calls)
+    time.sleep(0.2)
+    assert not client.get("/api/races/ext1/modal").json()["polling"] and len(stats.calls) == n
+

+class GpuFakeRunner(FakeRunner):
+    """FakeRunner that also emits one in-container GPU sample per run (like the demo container)."""
+
+    async def launch(self, target: str, config: dict[str, Any], seed: int, budget_s: int, on_metric: Any) -> Any:
+        h = await super().launch(target, config, seed, budget_s, on_metric)
+        on_metric(MetricPoint(experiment_id=h.run_id, step=0, t=0.0, name="gpu_util_pct", value=80.0))
+        return h

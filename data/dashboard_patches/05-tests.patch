+"""Live Modal metrics on our dashboard (demo races only), offline: fakes for Modal and the GPU.
+
+- ModalRunner adds ``gpu_telemetry`` to a job only when asked (demo); benchmark jobs are unchanged;
+- the container path samples the GPU beside the run only for such jobs, through the run's queue;
+- RaceConfig.gpu_telemetry_s is demo-only and set on the demo preset;
+- the app polls Modal stats only for demo races: GET /api/races/{id}/modal and 'modal_stats' events.
+"""
+
+from __future__ import annotations
+
+import asyncio
+import json
+import time
+from pathlib import Path
+from types import SimpleNamespace
+from typing import Any
+
+import pytest
+from fastapi.testclient import TestClient
+
+from backend.app import create_app, modal_stats_enabled
+from backend.benchmark.configs import DEMO_LABEL, PER_ARM_MODAL_APPS, PRESETS, RaceConfig
+from backend.core.events import MetricEvent, ModalStatsEvent, parse_event
+from backend.core.types import ArmKind, MetricPoint
+from backend.scheduler import ArmDeps
+from test_engine import SPEC, FakeLLM, FakeRunner, llm_arm
+from workers.runners import modal_stats as ms
+from workers.targets.base import TargetSpec, get_target
+
+modal_runner = pytest.importorskip("workers.runners.modal_runner")
+ModalRunner = modal_runner.ModalRunner
+
+DEMO = "demo-cifar-modal-5m"
+APPS = {k.value: v for k, v in PER_ARM_MODAL_APPS.items()}
+
+
+# --------------------------------------------------------------------------- fakes
+
+
+class _Aio:
+    def __init__(self, fn: Any) -> None:
+        self.aio = fn
+
+
+class _NoopCall:
+    _n = 0
+
+    def __init__(self) -> None:
+        _NoopCall._n += 1
+        self.object_id = f"fc-noop{_NoopCall._n}"
+        self.get = _Aio(self._get)
+        self.cancel = _Aio(self._cancel)
+
+    async def _get(self, timeout: float | None = None) -> Any:
+        await asyncio.sleep(timeout or 0)
+        raise TimeoutError
+
+    async def _cancel(self, **kw: Any) -> None:
+        return None
+
+
+class _RecordingFunction:
+    """Records spawned jobs; never runs anything."""
+
+    def __init__(self) -> None:
+        self.jobs: list[dict[str, Any]] = []
+        self.spawn = _Aio(self._spawn)
+
+    async def _spawn(self, job: dict[str, Any]) -> _NoopCall:
+        self.jobs.append(job)
+        return _NoopCall()
+
+
+class _ListQueue:
+    def __init__(self) -> None:
+        self.items: list[tuple[str, dict[str, Any]]] = []
+        self.get_many = _Aio(self._get_many)
+        self.clear = _Aio(self._clear)
+
+    def put_many(self, items: list[Any], partition: str | None = None, **_: Any) -> None:
+        self.items.extend((partition or "", it) for it in items)
+
+    async def _get_many(self, n: int, block: bool = True, partition: str | None = None, **_: Any) -> list[Any]:
+        return []
+
+    async def _clear(self, **_: Any) -> None:
+        return None
+
+
+class FakeStats:
+    """Stands in for modal.Function.from_name(app, fn).get_current_stats.aio()."""
+
+    def __init__(self, by_app: dict[str, tuple[int, int, int]]) -> None:
+        self.by_app = by_app
+        self.calls: list[tuple[str, str]] = []
+
+    async def __call__(self, app: str, function: str) -> Any:
+        self.calls.append((app, function))
+        backlog, total, running = self.by_app[app]
+        return SimpleNamespace(backlog=backlog, num_total_runners=total, num_running_inputs=running,
+                               input_headroom=0)
+
+
+# --------------------------------------------------------------------------- runner: job field
+
+
+async def _launch_job(**kw: Any) -> dict[str, Any]:
+    ModalRunner._global_busy.clear()
+    fn = _RecordingFunction()
+    r = ModalRunner({"L4": 1}, function_resolver=lambda name: fn, queue=_ListQueue(), poll_interval_s=0.05, **kw)
+    cfg = get_target("cifar").spec.default_config()
+    h = await r.launch("cifar", cfg, 0, 45, lambda p: None)
+    assert r.calls_in_flight() == [{"run_id": h.run_id, "modal_call_id": h.run_ref, "hardware": "L4",
+                                    "container_started_at": None, "cancelled": False}]
+    run = r._runs[h.run_id]
+    run.stop_polling = True
+    if run.poller is not None:
+        run.poller.cancel()
+    ModalRunner._global_busy.clear()
+    return fn.jobs[0]
+
+
+async def test_benchmark_jobs_have_no_telemetry_field() -> None:
+    job = await _launch_job()
+    assert set(job) == {"run_id", "target", "config", "seed", "budget_s", "started_at", "extra_imports",
+                        "queue_name"}
+    assert ModalRunner({"L4": 1}).gpu_telemetry_s is None
+
+
+async def test_demo_jobs_carry_the_telemetry_interval() -> None:
+    job = await _launch_job(gpu_telemetry_s=0.5)
+    assert job["gpu_telemetry"] == {"interval_s": 0.5}
+    with pytest.raises(ValueError):
+        ModalRunner({"L4": 1}, gpu_telemetry_s=0)
+

+def test_demo_preset_enables_telemetry_and_benchmarks_cannot() -> None:
+    demo = PRESETS[DEMO]
+    assert demo.gpu_telemetry_s == 1.0 and demo.model_dump(mode="json")["gpu_telemetry_s"] == 1.0
+    assert modal_stats_enabled(demo)

+             "engine_features": {"opus_bm": []}, "modal_apps": APPS, "demo_label": DEMO_LABEL,
+             "gpu_telemetry_s": 1.0}
+PLAIN_RACE = {"name": "plain", "target": SPEC.name, "arms": ["opus", "opus_bm"], "budget_s": 1.0,
+              "gpus_per_arm": 2, "seed": 0, "llm": "mock", "runner": "modal", "engine_features": {"opus_bm": []}}

+# --------------------------------------------------------------------------- container path
+
+
+def _container(monkeypatch: pytest.MonkeyPatch, *, run_s: float) -> _ListQueue:
+    q = _ListQueue()
+    monkeypatch.setattr(modal_runner, "_container_queue", lambda name: q)
+    monkeypatch.setattr(modal_runner, "_needs_volume", lambda *a, **k: False)   # never touch the Volume
+
+    def fake_execute(job: dict[str, Any], emit: Any) -> dict[str, Any]:
+        emit(0, 0.01, "train_loss", 2.0)
+        time.sleep(run_s)
+        return {"ok": True, "result": {"score": 0.9, "metrics": {"epochs": 1.0}}, "logs_tail": []}
+
+    monkeypatch.setattr(modal_runner, "execute_job", fake_execute)
+    return q
+
+
+def test_container_samples_gpu_only_with_the_flag(monkeypatch: pytest.MonkeyPatch) -> None:
+    q = _container(monkeypatch, run_s=0.35)
+    reads = {"n": 0}
+
+    def reader() -> list[ms.GpuReading]:
+        reads["n"] += 1
+        return [ms.GpuReading(0, 0.0 if reads["n"] == 1 else 93.0, 7000.0, 23034.0)]
+
+    monkeypatch.setattr(ms, "default_gpu_reader", lambda: reader)
+    job = {"run_id": "run-a", "target": "cifar", "config": {}, "seed": 0, "budget_s": 45,
+           "started_at": time.time(), "gpu_telemetry": {"interval_s": 0.05}}
+    payload = modal_runner._remote_execute(job)
+    metrics = [it for part, it in q.items if part == "run-a" and it.get("type") == "metric"]
+    names = [m["name"] for m in metrics]
+    assert "train_loss" in names
+    util = [m for m in metrics if m["name"] == "gpu_util_pct"]
+    assert len(util) >= 3 and util[0]["value"] == 0.0 and util[-1]["value"] == 93.0   # 0 % windows kept
+    assert [m["step"] for m in util] == list(range(len(util)))
+    assert names.count("gpu_mem_total_mb") == 1 and "gpu_mem_mb" in names
+    # telemetry never reaches the run's result (whose metrics go to the judge prompt)
+    assert payload["result"]["metrics"] == {"epochs": 1.0}
+
+
+def test_container_without_flag_never_starts_a_sampler(monkeypatch: pytest.MonkeyPatch) -> None:
+    q = _container(monkeypatch, run_s=0.05)
+
+    def boom(*a: Any, **k: Any) -> Any:
+        raise AssertionError("sampler started for a job without gpu_telemetry")
+
+    monkeypatch.setattr(ms, "GpuSampler", boom)
+    monkeypatch.setattr(ms, "sampler_for_job", boom)
+    job = {"run_id": "run-b", "target": "cifar", "config": {}, "seed": 0, "budget_s": 45, "started_at": time.time()}
+    payload = modal_runner._remote_execute(job)
+    assert payload["ok"]
+    assert [it["name"] for _, it in q.items if it.get("type") == "metric"] == ["train_loss"]

+    # ------------------------------------------------------------------ live Modal stats (demo)
+
+    def _race_live(race_id: str) -> bool:
+        eng = state.engines.get(race_id)
+        if eng is not None:
+            return eng.status in ("created", "running")
+        race = state.db.get_race(race_id)   # a race run by another process (scripts/bench.py)
+        return race is not None and race.get("status") in ("created", "running")
+
+    def _calls_by_arm(race_id: str) -> dict[str, list[dict[str, Any]]]:
+        kinds = {str(a["id"]): str(a["kind"]) for a in state.db.get_arms(race_id)}
+        return calls_in_flight_by_arm(state.db.list_experiments(race_id=race_id), kinds)
+
+    def _gpu_on_event(ev: Any) -> None:
+        """Feed in-container GPU samples (metric points) into the race's tracker."""
+        tr = state.gpu_trackers.get(ev.race_id)
+        if tr is None:
+            return
+        if ev.type == "metric" and ev.name in GPU_METRICS:
+            tr.observe(ev.arm.value, ev.experiment_id, ev.name, ev.value, ev.ts)
+        elif ev.type == "experiment_finished":
+            tr.finish(ev.arm.value, ev.experiment_id)
+
+    state.bus.add_listener(_gpu_on_event)
+
+    def _publish_modal_stats(race_id: str, snaps: list[FunctionStatsSnapshot]) -> None:
+        calls = _calls_by_arm(race_id)
+        tr = state.gpu_trackers.get(race_id)
+        now_s = time.time()
+        for s in snaps:
+            gpu = (tr.summary(s.arm, s.containers, s.calls_in_flight, now_s)
+                   if tr is not None and s.ok else {})
+            state.bus.publish(ModalStatsEvent(
+                race_id=race_id, ts=s.ts, arm=ArmKind(s.arm), app=s.app, function=s.function, ok=s.ok,
+                error=s.error, containers=s.containers, calls_in_flight=s.calls_in_flight, backlog=s.backlog,
+                input_headroom=s.input_headroom, idle_containers=s.idle_containers,
+                call_ids=[c["modal_call_id"] for c in calls.get(s.arm, []) if c["in_flight"]],
+                latest_call_id=latest_call_id(calls.get(s.arm, [])), poll_latency_s=s.poll_latency_s, **gpu))
+
+    def _ensure_modal_poller(race_id: str, cfg: RaceConfig) -> ModalStatsPoller | None:
+        """Start (or keep) polling a live demo race; a finished race keeps its last snapshot."""
+        state.gpu_trackers.setdefault(race_id, ArmGpuTracker())
+        p = state.modal_pollers.get(race_id)
+        if (p is not None and p.running) or not _race_live(race_id):
+            return p
+        try:
+            fn = function_for_hardware(get_target(cfg.target).spec.hardware)
+        except (KeyError, ImportError, ValueError) as e:
+            log.warning("no Modal stats for race %s: %s", race_id, e)
+            return p
+        log_path = os.path.join(state.modal_stats_dir, f"race-{race_id}.jsonl") if state.modal_stats_dir else None
+        p = ModalStatsPoller(
+            {k.value: v for k, v in cfg.modal_apps.items()}, fn, stats_fn=state.modal_stats_fn,
+            interval_s=state.modal_stats_interval_s, keep_going=lambda: _race_live(race_id),
+            max_runtime_s=float(cfg.budget_s) + MODAL_STATS_EXTRA_S, log_path=log_path,
+            on_snapshot=lambda snaps: _publish_modal_stats(race_id, snaps),
+        )
+        state.modal_pollers[race_id] = p
+        p.start()
+        return p
+

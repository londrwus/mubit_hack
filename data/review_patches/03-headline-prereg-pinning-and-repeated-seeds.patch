+def _fp_get(fp: Mapping[str, Any], path: str) -> Any:
+    cur: Any = fp
+    for part in path.split("."):
+        if not isinstance(cur, Mapping) or part not in cur:
+            return FP_ABSENT
+        cur = cur[part]
+    return cur
